# Sentinel Hub — same values as Dashboard repo
SENTINEL_CLIENT_ID=
SENTINEL_CLIENT_SECRET=

# Forsler — same values as Dashboard repo
FORSLER_API_KEY=
FORSLER_ORGANIZATION_ID=
FORSLER_BASE_URL=https://foresting-tomorrow-public-4yr7fia4nq-ey.a.run.app

# SoilSense — do NOT commit real values; no hardcoded fallback in code
SOILSENSE_BASE_URL=https://api.staging.soilsense.io
SOILSENSE_EMAIL=
SOILSENSE_PASSWORD=

# 3Bee / XNatura — API key from platform Settings → API keys (X-Api-Key header)
# Site 101561 = Xoco Gourmet, El Lago (COCABO has no 3Bee site)
XNATURA_API_KEY=
XNATURA_SITE_ID=101561
XNATURA_USER_SLUG=earth-surveillance
XNATURA_BASE_URL=https://platform.3bee.com

# EarthSurveillance public API — Gemini RAG chat, reached only via this
# HTTPS API (MCP server must NEVER connect to Postgres directly).
# Auth is login-based (POST /api/v1/auth/sign-in/), not a static token —
# needs a real, email-verified EarthSurveillance user account. A dedicated
# service account is recommended over a personal login.
EARTHSURVEILLANCE_API_BASE_URL=https://www.earthsurveillance.ai
EARTHSURVEILLANCE_EMAIL=
EARTHSURVEILLANCE_PASSWORD=

# NASA FIRMS — free instant signup at firms.modaps.eosdis.nasa.gov/api/area
# Optional: only fire_alerts needs this, every other tool works without it.
FIRMS_MAP_KEY=

# weather / soilgrids / gbif_biodiversity / elevation need no credentials at all.

# Server
PORT=8080
